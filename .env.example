# Backend configuration. Every variable is optional; the defaults run fully
# locally (JSON contracts, JSON history file, in-memory publisher, no AWS).
# template.yaml sets the AWS values for the Lambda deployment.

# Where contracts are read from: "local" (contracts/ JSON files) or "dynamodb".
EVENTGATE_STORAGE_BACKEND=local
# Where ALLOWed events go: "local" (in-memory, logged) or "eventbridge".
EVENTGATE_EVENT_PUBLISHER=local
# Release policy implementation: "standard" (Python) or "cedar" (cedarpy).
EVENTGATE_POLICY_ENGINE=standard

# Local mode: directory with events/ and consumers/ subfolders. Default: <repo>/contracts
# EVENTGATE_CONTRACTS_DIR=contracts
# Local mode: release history file. Default: <repo>/.eventgate/history.json (gitignored)
# EVENTGATE_HISTORY_FILE=.eventgate/history.json
# CLI only: "true" makes `eventgate check` record history without --persist.
# EVENTGATE_PERSIST_HISTORY=false

# DynamoDB mode: table names (defaults match the dev stack in template.yaml).
EVENT_CONTRACTS_TABLE_NAME=primex-eventgate-dev-event-contracts
CONSUMER_CONTRACTS_TABLE_NAME=primex-eventgate-dev-consumer-contracts
RELEASE_HISTORY_TABLE_NAME=primex-eventgate-dev-release-history
# EventBridge mode: custom bus that receives ALLOWed events.
EVENTBRIDGE_BUS_NAME=primex-eventgate-dev-bus
# AWS region for DynamoDB and EventBridge (Lambda sets this itself). Default: ap-south-1
AWS_REGION=ap-south-1
